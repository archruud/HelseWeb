# Helsejournal PHR - Environment Variables
# Kopier denne filen til .env og tilpass verdiene

# Database
DB_PASSWORD=endre_dette_til_et_sikkert_passord

# JWT Secret (generer med: openssl rand -hex 32)
SECRET_KEY=endre_dette_til_en_tilfeldig_streng

# AI Model (Ollama)
OLLAMA_MODEL=llama3:8b

# Frontend URL
FRONTEND_URL=http://localhost:3000
